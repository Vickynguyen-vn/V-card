import React, { useState } from "react";
import {
  User,
  Mail,
  Linkedin,
  Facebook,
  Globe,
  Download,
  MapPin,
  Share2,
  Check,
} from "lucide-react";

const DigitalCard = () => {
  const [copied, setCopied] = useState(false);

  // Personal info
  const profile = {
    name: "Vicky Nguyen",
    fullName: "Nguyen Doan Hanh Dung",
    title: "PhD Candidate | Lecturer",
    org: "NKUHT & Hue University",
    email1: "C1312008@stu.nkuht.edu.tw",
    email2: "Ndhdung@hueuni.edu.vn",
    linkedin: "https://www.linkedin.com/in/vicky-nguyen",
    facebook: "https://www.facebook.com/vickynguyen.vn",
    orcid: "https://orcid.org/0000-0003-2631-5222",
    location: "Vietnam & Taiwan",
  };

  // Create & download a .vcf contact card
  const generateVCard = () => {
    // Use CRLF \r\n for better compatibility on phones
    const vcardString = [
      "BEGIN:VCARD",
      "VERSION:3.0",
      `FN:${profile.name}`,
      "N:Nguyen;Vicky;;;",
      `TITLE:${profile.title}`,
      `ORG:${profile.org}`,
      `EMAIL;TYPE=INTERNET;TYPE=WORK:${profile.email1}`,
      `EMAIL;TYPE=INTERNET;TYPE=HOME:${profile.email2}`,
      `URL;TYPE=LinkedIn:${profile.linkedin}`,
      `URL;TYPE=Facebook:${profile.facebook}`,
      `URL;TYPE=ORCID:${profile.orcid}`,
      "NOTE:Empowering Minds. Regenerating Destinations.",
      "END:VCARD",
    ].join("\r\n");

    const encoded = encodeURIComponent(vcardString);
    const href = `data:text/vcard;charset=utf-8,${encoded}`;

    const link = document.createElement("a");
    link.href = href;
    link.download = "Vicky_Nguyen.vcf";
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  // Copy the canonical URL (good for QR sharing once deployed)
  const copyLink = async () => {
    const url = `${window.location.origin}${window.location.pathname}`;

    try {
      await navigator.clipboard.writeText(url);
      setCopied(true);
      setTimeout(() => setCopied(false), 2000);
    } catch (e) {
      // Fallback for Safari / blocked clipboard
      const textarea = document.createElement("textarea");
      textarea.value = url;
      textarea.setAttribute("readonly", "");
      textarea.style.position = "absolute";
      textarea.style.left = "-9999px";
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand("copy");
      document.body.removeChild(textarea);

      setCopied(true);
      setTimeout(() => setCopied(false), 2000);
    }
  };

  // Optional: native share sheet on mobile (if supported)
  const shareCard = async () => {
    const url = `${window.location.origin}${window.location.pathname}`;
    if (navigator.share) {
      try {
        await navigator.share({
          title: profile.name,
          text: "My digital business card",
          url,
        });
      } catch (e) {
        // user cancelled share -> ignore
      }
    } else {
      copyLink();
    }
  };

  return (
    <div className="min-h-screen bg-gray-100 flex items-center justify-center p-4 font-sans">
      <div className="w-full max-w-md bg-white shadow-2xl rounded-3xl overflow-hidden relative">
        {/* Header */}
        <div className="h-48 bg-gradient-to-br from-[#C05832] to-[#8a3c20] relative">
          <div className="absolute inset-0 opacity-20 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"></div>

          {/* Share button */}
          <button
            onClick={shareCard}
            className="absolute top-4 right-4 bg-white/20 backdrop-blur-sm p-2 rounded-full text-white hover:bg-white/30 transition"
            aria-label="Share"
            title="Share"
          >
            {copied ? <Check size={20} /> : <Share2 size={20} />}
          </button>
        </div>

        {/* Content */}
        <div className="px-6 relative">
          {/* Avatar placeholder */}
          <div className="w-32 h-32 mx-auto -mt-16 rounded-full border-4 border-white bg-gray-200 flex items-center justify-center shadow-lg relative z-10 overflow-hidden">
            <div className="w-full h-full bg-gray-100 flex flex-col items-center justify-center text-gray-400">
              <User size={48} />
              <span className="text-xs mt-1">Your photo</span>
            </div>
            {/* If you have a real photo, use this instead:
            <img src="YOUR_PHOTO_URL" alt="Vicky Nguyen" className="w-full h-full object-cover" />
            */}
          </div>

          <div className="text-center mt-4 mb-8">
            <h1 className="text-2xl font-bold text-gray-800">{profile.name}</h1>
            <p className="text-sm text-gray-500 mb-1">{profile.fullName}</p>

            <div className="inline-block px-3 py-1 bg-orange-50 text-[#C05832] rounded-full text-xs font-semibold tracking-wide border border-orange-100 mt-2">
              {profile.title}
            </div>

            <div className="flex items-center justify-center gap-1 text-gray-400 text-xs mt-3">
              <MapPin size={12} />
              <span>{profile.location}</span>
            </div>
          </div>

          {/* Main action button */}
          <button
            onClick={generateVCard}
            className="w-full bg-[#C05832] hover:bg-[#a04625] text-white font-bold py-3.5 px-6 rounded-xl shadow-lg transform transition active:scale-95 flex items-center justify-center gap-2 mb-8"
          >
            <Download size={20} />
            Add to Contacts
          </button>

          {/* Links */}
          <div className="space-y-4 mb-10">
            {/* Email 1 */}
            <a
              href={`mailto:${profile.email1}`}
              className="flex items-center p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition border border-gray-100 group"
            >
              <div className="w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center mr-4 group-hover:scale-110 transition">
                <Mail size={20} />
              </div>
              <div className="flex-1 overflow-hidden">
                <p className="text-xs text-gray-500 font-semibold uppercase">
                  NKUHT Email
                </p>
                <p className="text-gray-800 text-sm truncate">{profile.email1}</p>
              </div>
            </a>

            {/* Email 2 */}
            <a
              href={`mailto:${profile.email2}`}
              className="flex items-center p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition border border-gray-100 group"
            >
              <div className="w-10 h-10 rounded-full bg-teal-100 text-teal-600 flex items-center justify-center mr-4 group-hover:scale-110 transition">
                <Mail size={20} />
              </div>
              <div className="flex-1 overflow-hidden">
                <p className="text-xs text-gray-500 font-semibold uppercase">
                  Hue Uni Email
                </p>
                <p className="text-gray-800 text-sm truncate">{profile.email2}</p>
              </div>
            </a>

            {/* LinkedIn */}
            <a
              href={profile.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              className="flex items-center p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition border border-gray-100 group"
            >
              <div className="w-10 h-10 rounded-full bg-blue-50 text-[#0077b5] flex items-center justify-center mr-4 group-hover:scale-110 transition">
                <Linkedin size={20} />
              </div>
              <div className="flex-1">
                <p className="text-xs text-gray-500 font-semibold uppercase">LinkedIn</p>
                <p className="text-gray-800 text-sm font-medium">Connect with me</p>
              </div>
            </a>

            {/* Facebook */}
            <a
              href={profile.facebook}
              target="_blank"
              rel="noopener noreferrer"
              className="flex items-center p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition border border-gray-100 group"
            >
              <div className="w-10 h-10 rounded-full bg-blue-50 text-[#1877F2] flex items-center justify-center mr-4 group-hover:scale-110 transition">
                <Facebook size={20} />
              </div>
              <div className="flex-1">
                <p className="text-xs text-gray-500 font-semibold uppercase">Facebook</p>
                <p className="text-gray-800 text-sm font-medium">vickynguyen.vn</p>
              </div>
            </a>

            {/* ORCID */}
            <a
              href={profile.orcid}
              target="_blank"
              rel="noopener noreferrer"
              className="flex items-center p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition border border-gray-100 group"
            >
              <div className="w-10 h-10 rounded-full bg-green-50 text-[#A6CE39] flex items-center justify-center mr-4 group-hover:scale-110 transition">
                <Globe size={20} />
              </div>
              <div className="flex-1">
                <p className="text-xs text-gray-500 font-semibold uppercase">
                  Research Profile
                </p>
                <p className="text-gray-800 text-sm font-medium">ORCID Record</p>
              </div>
            </a>
          </div>

          <div className="text-center pb-8 border-t border-gray-200 pt-6">
            <p className="font-serif italic text-gray-400 text-lg">
              “Empowering Minds.<br />
              Regenerating Destinations.”
            </p>
          </div>
        </div>
      </div>
    </div>
  );
};

export default DigitalCard;
